# ===== Telegram-бот с локальной LLM: конфигурация =====
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# Токен Telegram-бота от @BotFather (обязательно)
BOT_TOKEN=

# Адрес Ollama-сервера
OLLAMA_URL=http://127.0.0.1:11434

# Модель Ollama (будет скачана автоматически при первом запросе,
# либо заранее: ollama pull qwen3:14b)
MODEL=qwen3:14b

# Запасные IP api.telegram.org через запятую.
# Пусто = обычный DNS. Заполняйте только если сеть блокирует Telegram.
TELEGRAM_API_IPS=

# Системный промпт
SYSTEM_PROMPT=Ты — дружелюбный и полезный ассистент в Telegram. Отвечай всегда на языке собеседника (по умолчанию — на русском). Отвечай кратко и по делу, если не просят подробностей.

# Параметры генерации
# Контекст (токенов). 16384 — разумно для 8-32GB RAM.
NUM_CTX=16384
# Слоёв на GPU: -1 = авто, 0 = только CPU, N = вручную.
# Для 6GB VRAM и 14B-модели оптимально ~19 (см. README).
NUM_GPU=-1
# Максимум токенов в ответе
NUM_PREDICT=2048
TEMPERATURE=0.7
TOP_P=0.8

# Режим размышлений Qwen3 (true = глубже, но медленнее)
THINK=false

# История диалога: сколько сообщений помнит бот на каждый чат
MAX_HISTORY_MESSAGES=30

# Интервал обновления стриминга в Telegram (сек)
EDIT_INTERVAL=1.5

# Таймаут запроса к Ollama (сек)
REQUEST_TIMEOUT=600
